{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "standard-eg",
  "account_id": "8ed42e2817be8f4442920225278a265a",
  "compatibility_date": "2026-08-01",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "routes": [
    { "pattern": "standardcatering.org", "custom_domain": true },
    { "pattern": "www.standardcatering.org", "custom_domain": true }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
